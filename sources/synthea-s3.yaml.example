# Rename to .yaml to enable. The bucket is read with the credential named
# lab-feeds, stored through POST /api/secrets (an access key id and secret
# access key); a public bucket says anonymous: true instead.
id: synthea-s3
name: Synthea NDJSON on S3
source:
  type: s3
  bucket: my-lab-feeds
  prefix: synthea/
  region: us-east-1
  credential: lab-feeds
  # endpoint: http://localhost:9000   # MinIO or another S3-compatible store
  pattern: "*.ndjson"
  poll_seconds: 30
  archive_prefix: synthea-processed
format: ndjson
transform: transforms/fhir_passthrough.py
delivery:
  batch_size: 200
expect_every: 24h
